# Copy to apps/web/.env.local. Only VITE_* values are public in the browser.
VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=/api

# Vite's local proxy target; this variable is not exposed to the browser.
API_TARGET=http://127.0.0.1:3001

# Supabase project credentials (public/publishable key only, never a secret/service_role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
