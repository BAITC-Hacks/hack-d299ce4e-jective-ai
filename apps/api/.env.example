# Copy to apps/api/.env. Loaded by server.js; existing environment takes precedence.
HOST=127.0.0.1
PORT=3001

# Use the same project/public key as apps/web/.env. Never use service_role/secret keys.
# Leave both empty to keep the API catalogue working without authentication configured.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use SUPABASE_ANON_KEY instead of SUPABASE_PUBLISHABLE_KEY.
